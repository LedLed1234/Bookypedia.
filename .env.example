# Mit `openssl rand -hex 32` erzeugen und niemals committen.
SECRET_KEY=hier-einen-zufaelligen-schluessel-eintragen

# Öffentlicher DNS-Name, dessen A/AAAA-Eintrag auf den VPS zeigt.
BOOKYPEDIA_DOMAIN=books.example.com

# Lokaler Host-Port hinter dem zentralen Reverse Proxy. Auf dem Moviepedia-
# Checkout des VPS wird 8001 verwendet; Bookypedia bleibt auf 8000.
APP_PORT=8001

# Optionale Logging-Einstellungen.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional: überschreibt readmore/static/config.json. Für Google Books ist ein
# eigener API-Key im produktiven Betrieb empfohlen, um anonyme Quoten zu vermeiden.
# BOOK_PROVIDER=open_library
# BOOK_FALLBACK_PROVIDER=google_books
# GOOGLE_BOOKS_API_KEY=

# TMDB API Read Access Token für die Film- und Seriensuche. Niemals committen.
# TMDB_READ_ACCESS_TOKEN=
