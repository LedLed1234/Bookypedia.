[Unit]
Description=Epiloguehouse automatisch von GitHub deployen
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Environment=EPILOGUEHOUSE_APP_DIR=/opt/bookypedia
Environment=EPILOGUEHOUSE_BRANCH=main
ExecStart=/usr/local/sbin/epiloguehouse-auto-deploy

# Ein fehlerhafter Durchlauf wird beim nächsten Timer-Lauf erneut versucht.
TimeoutStartSec=15min
Nice=10
