[Unit]
Description=Bookypedia und Moviepedia automatisch von GitHub deployen
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Environment=EPILOGUEHOUSE_BOOK_DIR=/opt/bookypedia
Environment=EPILOGUEHOUSE_BOOK_BRANCH=main
Environment=EPILOGUEHOUSE_BOOK_PORT=8000
Environment=EPILOGUEHOUSE_MOVIE_DIR=/opt/moviepedia
Environment=EPILOGUEHOUSE_MOVIE_BRANCH=movies
Environment=EPILOGUEHOUSE_MOVIE_PORT=8001
ExecStart=/usr/local/sbin/epiloguehouse-auto-deploy

# Ein fehlerhafter Durchlauf wird beim nächsten Timer-Lauf erneut versucht.
TimeoutStartSec=15min
Nice=10
