#!/usr/bin/env bash

set -Euo pipefail

readonly BOOK_DIR="${EPILOGUEHOUSE_BOOK_DIR:-/opt/bookypedia}"
readonly BOOK_BRANCH="${EPILOGUEHOUSE_BOOK_BRANCH:-main}"
readonly BOOK_PORT="${EPILOGUEHOUSE_BOOK_PORT:-8000}"
readonly MOVIE_DIR="${EPILOGUEHOUSE_MOVIE_DIR:-/opt/moviepedia}"
readonly MOVIE_BRANCH="${EPILOGUEHOUSE_MOVIE_BRANCH:-movies}"
readonly MOVIE_PORT="${EPILOGUEHOUSE_MOVIE_PORT:-8001}"
readonly STATE_DIR="/var/lib/epiloguehouse-deploy"
readonly LOCK_FILE="/run/lock/epiloguehouse-deploy.lock"

log() {
  printf '[epiloguehouse-deploy] %s\n' "$*"
}

if [[ ${EUID} -ne 0 ]]; then
  log "Dieses Skript muss als root ausgeführt werden."
  exit 1
fi

exec 9>"${LOCK_FILE}"
if ! flock -n 9; then
  log "Ein Deployment läuft bereits; dieser Durchlauf wird übersprungen."
  exit 0
fi

deploy_app() {
  local name="$1"
  local app_dir="$2"
  local branch="$3"
  local port="$4"
  local deployed_commit_file="${STATE_DIR}/${name}-deployed-commit"
  local current_branch current_commit remote_commit deployed_commit="" healthy=0
  local -a git_safe compose

  if [[ ! -d "${app_dir}/.git" ]]; then
    log "${name}: Kein Git-Repository unter ${app_dir} gefunden."
    return 1
  fi

  git_safe=(git -c "safe.directory=${app_dir}" -C "${app_dir}")
  compose=(
    docker compose
    --env-file "${app_dir}/.env"
    -p "${name}"
    -f "${app_dir}/compose.prod.yaml"
  )

  current_branch="$("${git_safe[@]}" symbolic-ref --quiet --short HEAD || true)"
  if [[ "${current_branch}" != "${branch}" ]]; then
    log "${name}: Checkout ist '${current_branch:-detached}', erwartet wird '${branch}'."
    return 1
  fi

  if ! "${git_safe[@]}" diff --quiet || ! "${git_safe[@]}" diff --cached --quiet; then
    log "${name}: Im Produktions-Checkout liegen lokale Änderungen."
    return 1
  fi

  if ! "${git_safe[@]}" fetch --quiet origin "${branch}"; then
    log "${name}: Git-Fetch ist fehlgeschlagen."
    return 1
  fi
  remote_commit="$("${git_safe[@]}" rev-parse "origin/${branch}")" || return 1
  if [[ -f "${deployed_commit_file}" ]]; then
    deployed_commit="$(<"${deployed_commit_file}")"
  fi

  if [[ "${remote_commit}" == "${deployed_commit}" ]]; then
    return 0
  fi

  current_commit="$("${git_safe[@]}" rev-parse HEAD)" || return 1
  if ! "${git_safe[@]}" merge-base --is-ancestor "${current_commit}" "${remote_commit}"; then
    log "${name}: ${branch} wurde verändert oder der Checkout ist abgewichen."
    return 1
  fi

  log "${name}: Aktualisiere ${current_commit:0:12} auf ${remote_commit:0:12} …"
  if ! "${git_safe[@]}" pull --ff-only origin "${branch}"; then
    log "${name}: Git-Pull ist fehlgeschlagen."
    return 1
  fi

  log "${name}: Baue und starte die Container auf Port ${port} …"
  if ! APP_PORT="${port}" "${compose[@]}" up --build -d --remove-orphans; then
    log "${name}: Docker Compose ist fehlgeschlagen."
    return 1
  fi

  for _attempt in {1..30}; do
    if curl --fail --silent "http://127.0.0.1:${port}/health" >/dev/null; then
      healthy=1
      break
    fi
    sleep 2
  done

  if [[ ${healthy} -ne 1 ]]; then
    log "${name}: Healthcheck auf Port ${port} war nach 60 Sekunden nicht erfolgreich."
    APP_PORT="${port}" "${compose[@]}" ps
    return 1
  fi

  if ! install -d -m 0755 "${STATE_DIR}"; then
    log "${name}: Statusverzeichnis konnte nicht angelegt werden."
    return 1
  fi
  if ! printf '%s\n' "${remote_commit}" >"${deployed_commit_file}"; then
    log "${name}: Deployment-Status konnte nicht gespeichert werden."
    return 1
  fi
  log "${name}: Deployment von ${remote_commit:0:12} erfolgreich."
}

result=0
deploy_app "bookypedia" "${BOOK_DIR}" "${BOOK_BRANCH}" "${BOOK_PORT}" || result=1
deploy_app "moviepedia" "${MOVIE_DIR}" "${MOVIE_BRANCH}" "${MOVIE_PORT}" || result=1
exit "${result}"
